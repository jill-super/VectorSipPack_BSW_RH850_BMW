                            <SD GID="SOURCE_URI.0">platform:/resource/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined.sym#/BMW/Boardnet/Signals/RQ_RST_OBD_DIAG_DRDY?type=Signal&amp;bne_32A695E8944F440980B86E5C6A1148D5</SD>
