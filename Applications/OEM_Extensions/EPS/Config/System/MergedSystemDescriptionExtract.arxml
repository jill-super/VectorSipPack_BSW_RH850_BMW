                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="SYMPHONY_SOURCE_DESCRIPTION">
                            <SD GID="SOURCE_CLASS">com.bmw.symphony.exporter.autosar412.symphony10.transform.commatrix.common.AR_SystemSignalBuilder</SD>
                            <SD GID="SOURCE_CACHE">_createCache_createSystemSignal</SD>
                            <SD GID="SOURCE_URI.0">platform:/resource/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined.sym#/BMW/Boardnet/Signals/TRGG_ENGTORQ_EPS?type=Signal&amp;bne_E716EFB46A29429EBEF5B7D5737FF0C0</SD>
                            <SD GID="SOURCE_SOURCEINFO.0.ModelCombiner">platform:/resource/SP2018_16KW39_SymphonyModel/SP2018_16KW39_SymphonyModel.sym#/BMW/Boardnet/Signals/TRGG_ENGTORQ_EPS?type=Signal&amp;bne_E716EFB46A29429EBEF5B7D5737FF0C0</SD>
                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@1148eca4 (name: TRGG_ENGTORQ_EPS) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
                      <PHYSICAL-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                          <SW-DATA-DEF-PROPS-CONDITIONAL>
                            <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/Boardnet/CodingDatatypes/CompuMethodsForBoardnet/TRGG_ENGTORQ_EPS</COMPU-METHOD-REF>
