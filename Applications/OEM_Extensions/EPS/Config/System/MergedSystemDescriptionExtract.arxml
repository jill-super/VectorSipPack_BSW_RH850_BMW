                    <SYSTEM-SIGNAL>
                      <SHORT-NAME>OFFS_GRD_MID_EPS</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="DE">Offset_Zahnstange_Mitte_EPS</L-4>
                        <L-4 L="EN">offset_gear-rod_middle_EPS</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="DE">LogicalInterface:BMW.CHASSIS.STEERING.ElectricPowerSteering[internal]@Fahren;
Offset zwischen Zahnstangenmitte und dem Lenkwinkel-Nullpunkt (Geradeauslauf).
Das Signal wird ohne Einheit übertragen. Die Einheit kann aus dem Signal "Einheit_Position_EPS" entnommen werden:
- Im F25/L7 ist das Signal als Zahnstangenhub zu interpretieren. Die Einheit ist somit 0.2mm.</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="SYMPHONY_SOURCE_DESCRIPTION">
                            <SD GID="SOURCE_CLASS">com.bmw.symphony.exporter.autosar412.symphony10.transform.commatrix.common.AR_SystemSignalBuilder</SD>
                            <SD GID="SOURCE_CACHE">_createCache_createSystemSignal</SD>
                            <SD GID="SOURCE_URI.0">platform:/resource/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined.sym#/BMW/Boardnet/Signals/OFFS_GRD_MID_EPS?type=Signal&amp;bne_99FD6A6F88664F46A45DAE1EAC3E4BB9</SD>
                            <SD GID="SOURCE_SOURCEINFO.0.ModelCombiner">platform:/resource/SP2018_16KW39_SymphonyModel/SP2018_16KW39_SymphonyModel.sym#/BMW/Boardnet/Signals/OFFS_GRD_MID_EPS?type=Signal&amp;bne_99FD6A6F88664F46A45DAE1EAC3E4BB9</SD>
                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@1517015c (name: OFFS_GRD_MID_EPS) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
                      <PHYSICAL-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                          <SW-DATA-DEF-PROPS-CONDITIONAL>
                            <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/Boardnet/CodingDatatypes/CompuMethodsForBoardnet/OFFS_GRD_MID_EPS</COMPU-METHOD-REF>
                            <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/Boardnet/CodingDatatypes/DataConstraints/OFFS_GRD_MID_EPS</DATA-CONSTR-REF>
                          </SW-DATA-DEF-PROPS-CONDITIONAL>
                        </SW-DATA-DEF-PROPS-VARIANTS>
                      </PHYSICAL-PROPS>
                    </SYSTEM-SIGNAL>
                    <SYSTEM-SIGNAL>
                      <SHORT-NAME>OFFS_QUAD_RTR_EPS</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="DE">Offset_Quadrant_Rotor_EPS</L-4>
                        <L-4 L="EN">offset_quadrant_rotor_EPS</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="DE">LogicalInterface:BMW.CHASSIS.STEERING.ElectricPowerSteering[internal]@Fahren;
Mittels Aufsetzalgorithmus ermittelter Offset des aktuellen Nullpunktes der EPS-Position (entspricht der Segmentmitte des Segments in dem sich der EPS-Rotor z.B. nach dem letzten Einbruch der Spannungsversorgung befand) zum absoluten Nullpunkt (Segmentmitte des Segments bei Geradeausfahrt).
Der Offset wird angegeben als Anzahl voller Umdrehungen des EPS-Rotors (entspr. Anzahl Segmente).</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="SYMPHONY_SOURCE_DESCRIPTION">
