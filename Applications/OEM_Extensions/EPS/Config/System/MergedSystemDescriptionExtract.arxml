                <I-SIGNAL-I-PDU UUID="_677e18af96434b57a7947ca5849af5e4">
                  <SHORT-NAME>ERRM_BN_U</SHORT-NAME>
                  <LONG-NAME>
                    <L-4 L="DE">Fehlerspeicher Bordnetz Spannung</L-4>
                    <L-4 L="EN">Fehlerspeicher Bordnetz Spannung</L-4>
                  </LONG-NAME>
                  <DESC>
                    <L-2 L="DE">Diese Botschaft beinhaltet das Signal Steuerung Fehlerspeicher Bordnetzspannung mit dem Ziel der Bereitstellung von Spannungsschwellen für das Fehlerspeicherhandling.
Diese Botschaft wird von einigen Versionen der DME nicht verschickt. Es darf daher auf Empfängerseite keine Timeout-Fehlerspeichereinträge dazu geben. Die Empfänger müssen bei Timeout dieser Botschaft eine interne Ersatzwertbildung vornehmen.</L-2>
                  </DESC>
                  <ADMIN-DATA>
                    <DOC-REVISIONS>
                      <DOC-REVISION>
                        <REVISION-LABEL>4.0.0</REVISION-LABEL>
                        <STATE>closed</STATE>
                        <DATE>2017-01-09T00:00:00Z</DATE>
                      </DOC-REVISION>
                    </DOC-REVISIONS>
                  </ADMIN-DATA>
                  <LENGTH>2</LENGTH>
                  <I-PDU-TIMING-SPECIFICATIONS>
                    <I-PDU-TIMING>
                      <MINIMUM-DELAY>0.01</MINIMUM-DELAY>
                      <TRANSMISSION-MODE-DECLARATION>
