                            <SYMBOL>QU_AVL_RPM_WHL_ErsatzwertIstImNutzsignalGesetzt</SYMBOL>
                            <DESC>
                              <L-2 L="DE">Wird gelegt, solange keine gültige Drehrichtung erkannt wurde. (z.B. Stillstand)
Kann nur bei Sensoren mit Drehrichtungserkennung gesetzt werden.</L-2>
                              <L-2 L="FOR-ALL">BNE original name: Ersatzwert ist im Nutzsignal gesetzt</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">4</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">4</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>ErsatzwertIstImNutzsignalGesetzt</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
