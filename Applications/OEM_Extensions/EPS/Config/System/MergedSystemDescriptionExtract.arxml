                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/AUTOSAR_Platform/BaseTypes/uint8</BASE-TYPE-REF>
                        <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/SystemDescription/CompuMethods/ST_CON_VEH</COMPU-METHOD-REF>
                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/SystemDescription/DataConstrs/ST_CON_VEH</DATA-CONSTR-REF>
