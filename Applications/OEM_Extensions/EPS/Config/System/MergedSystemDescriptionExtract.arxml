                  </ADMIN-DATA>
                  <COMPU-INTERNAL-TO-PHYS>
                    <COMPU-SCALES>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Initialisierung</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Nach jedem Reset und Aufstarten des EPS-Steuergeräts.
Nutzsignal wird permanent mit Nutzwert 0 befüllt.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">8</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">8</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Initialisierung</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signalwert_ist_gueltig_und_abgesichert_und_plausibilisiert</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Position ist aufgesetzt und offsetkompensiert.
Sensorwert gültig und elektrische Überwachung i.O. und EPS intern plausibilisiert</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">1</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">1</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signalwert ist gültig und abgesichert und plausibilisiert</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signalwert_ist_gueltig</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Position ist aufgesetzt und offsetkompensiert
Sensorwert gültig und elektrische Überwachung i.O.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">2</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">2</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signalwert ist gültig</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Ersatzwert_ist_im_Nutzsignal_gesetzt</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Signalwert rein aus dem Sensor, d.h. die Position ist aufintegriert (Relativ)
Sensorwert gültig und elektrische Überwachung i.O.
FUSI: keine Verwendung für sicherheitsrelevante Funktionen.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">4</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">4</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Ersatzwert ist im Nutzsignal gesetzt</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signalwert_ist_gueltig_Zustand_Status_temporaer_mittlere_Signalqualitaet_</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Wird erst ab SP2015 unterstützt:
Position ist aufgesetzt. Die minimale Signaltoleranz ist allerdings noch nicht erreicht.
Sensorwert gültig und elektrische Überwachung i.O.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">9</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">9</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signalwert ist gültig, Zustand/Status temporär (mittlere Signalqualität)</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signalwert_ist_gueltig_Zustand_Status_temporaer_geringe_Signalqualitaet_</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Position ist aufgesetzt, es liegt aber noch eine Signaltoleranz bis etwa 30° Lenkradwinkel vor.
Sensorwert gültig und elektrische Überwachung i.O.
Wird erst ab SP2013 (außer F15-F16, 444) unterstützt.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">10</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">10</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signalwert ist gültig, Zustand/Status temporär (geringe Signalqualität)</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Abgleichwert_ist_im_Nutzsignal_gesetzt_Zustand_Status_temporaer</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Nicht vertrauenswürdige aufgesetzte und offsetkompensierte Position, die in diesem Zustand korrigiert wird (durch Aufsetzalgorithmus im ICM).
Dieser Zustand bleibt mindestens 50ms bestehen.
FUSI: keine Verwendung für sicherheitsrelevante Funktionen.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">12</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">12</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Abgleichwert ist im Nutzsignal gesetzt,  Zustand/Status temporär</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signalwert_ist_ungueltig_Zustand_Status_temporaer</SYMBOL>
                        <DESC>
                          <L-2 L="DE">Das zugehörige Nutzsignal wird permanent mit der Ungültigkeitskennung befüllt.
Wird gesetzt bei internen EPS Fehler (Sensor Fehler, Interner Kommunikationsfehler,...)
Dieser Zustand bleibt mindestens 20ms bestehen.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">14</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">14</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signalwert ist ungültig, Zustand/Status temporär</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <SYMBOL>QU_AVL_PINA_EPS_Signal_ungueltig</SYMBOL>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">15</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">15</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>Signal ungültig</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                    </COMPU-SCALES>
                  </COMPU-INTERNAL-TO-PHYS>
                </COMPU-METHOD>
