                      <DOC-REVISION>
                        <REVISION-LABEL>6.0.0</REVISION-LABEL>
                        <STATE>closed</STATE>
                        <DATE>2017-01-09T00:00:00Z</DATE>
                      </DOC-REVISION>
                    </DOC-REVISIONS>
