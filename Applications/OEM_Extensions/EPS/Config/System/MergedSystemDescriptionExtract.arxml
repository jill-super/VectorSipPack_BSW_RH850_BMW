                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@7f6a0ab (name: CTR_BS_PRTNT) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
