                    <SYSTEM-SIGNAL>
                      <SHORT-NAME>ST_UDP</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="DE">Status_Spannungseinbruch</L-4>
                        <L-4 L="EN">status_voltage-drop</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="DE">LogicalInterface:BMW.POWERTRAIN.ENGINE.DrivingReadinessEngineStart[external]@Fahren;
In diesem Signal wird der Startspannungseinbruch vor dem Start angekündigt (mindestens 70 ms vor dem Startspannungseinbruch) und behält den Zustand während des Startvorgangs bei. Die Entscheidung für einen Einbruch bis Spannungsschwelle 1 (Warmstart) bzw. Spannungsschwelle 2 (Kaltstart) wird anhand einer applizierbaren Motortemperaturschwelle getroffen. Der applizierte Wert entspricht der Temperaturschwelle von MSA.
Codierung 0001 "Startspannungseinbruch bis maximal Spannungsschwelle 1" wird nur gesetzt, wenn zusätzlich kein MSA-Abschaltverhinderer durch SOC/SOH gesetzt ist.
Der Spannungseinbruch basiert auf Temperaturabschätzung. Wird ein Einbruch auf Schwelle 1 oder 2 angekündigt, so erfolgt während des Starts bei geänderter Temperatur kein Wechsel auf die dann gültige Schwelle.</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="SYMPHONY_SOURCE_DESCRIPTION">
                            <SD GID="SOURCE_CLASS">com.bmw.symphony.exporter.autosar412.symphony10.transform.commatrix.common.AR_SystemSignalBuilder</SD>
                            <SD GID="SOURCE_CACHE">_createCache_createSystemSignal</SD>
