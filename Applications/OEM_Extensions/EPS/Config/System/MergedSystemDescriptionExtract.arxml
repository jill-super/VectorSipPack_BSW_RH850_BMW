                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <SHORT-LABEL>Wert_nicht_verfuegbar_Fehler_elektrisch</SHORT-LABEL>
                            <SYMBOL>QU_AVL_RPM_WHL_Wert_nicht_verfuegbar_Fehler_elektrisch</SYMBOL>
                            <DESC>
                              <L-2 L="DE">Im Fehlerfall wird abhängig von der Ursache entweder 0110 (Schwerpunkt: elektrische Fehler mit Reparaturbedarf) oder  1110 (Schwerpunkt: Plausibilitätsfehler ohne Reparaturbedarf) gesendet. Die Umsetzung ist produktlinienspezifisch unterschiedlich.
Nutzsignal wird permanent mit der Ungültigkeitskennung befüllt.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">6</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">6</UPPER-LIMIT>
                            <COMPU-CONST>
