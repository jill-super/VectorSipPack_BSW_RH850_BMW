                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </NETWORK-REPRESENTATION-PROPS>
                  <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/BMW/SystemDescription/SystemSignals/CRC_DISP_CC_EPS</SYSTEM-SIGNAL-REF>
