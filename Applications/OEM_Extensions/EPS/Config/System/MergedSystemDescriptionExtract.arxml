                        <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/SystemDescription/CompuMethods/CRC8</COMPU-METHOD-REF>
                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/SystemDescription/DataConstrs/CRC8</DATA-CONSTR-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </NETWORK-REPRESENTATION-PROPS>
                  <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/BMW/SystemDescription/SystemSignals/CRC_ENSU_SFY</SYSTEM-SIGNAL-REF>
                </I-SIGNAL>
