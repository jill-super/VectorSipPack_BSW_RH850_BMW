                    <L-4 L="DE">ENSU_SFY_dummy_32_63</L-4>
                    <L-4 L="EN">ENSU_SFY_dummy_32_63</L-4>
                  </LONG-NAME>
                  <DATA-TYPE-POLICY>LEGACY</DATA-TYPE-POLICY>
