                  <NETWORK-REPRESENTATION-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/AUTOSAR_Platform/BaseTypes/uint16</BASE-TYPE-REF>
                        <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/SystemDescription/CompuMethods/ACLNY_COG</COMPU-METHOD-REF>
                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/SystemDescription/DataConstrs/ACLNY_COG</DATA-CONSTR-REF>
                        <INVALID-VALUE>
                          <NUMERICAL-VALUE-SPECIFICATION>
                            <VALUE>65535</VALUE>
