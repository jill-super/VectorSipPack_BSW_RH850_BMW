                            <SD GID="SOURCE_URI.0">platform:/resource/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined/RootProject_ECU_EF-SYMPHONY-TESTSG_Combined.sym#/BMW/Boardnet/Signals/QU_FN_EST?type=Signal&amp;bne_8FCD25D281BF43F7836594D2433BDF22</SD>
