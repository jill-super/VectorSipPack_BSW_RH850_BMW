                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@21a1790d (name: ST_UDP) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
