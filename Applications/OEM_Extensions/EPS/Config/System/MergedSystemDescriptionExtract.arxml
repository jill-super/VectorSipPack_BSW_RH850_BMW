                  <I-PDU-TIMING-SPECIFICATIONS>
                    <I-PDU-TIMING>
                      <TRANSMISSION-MODE-DECLARATION>
                        <TRANSMISSION-MODE-TRUE-TIMING>
                          <CYCLIC-TIMING>
                            <DESC>
                              <L-2 L="DE">Um sicherzustellen, dass das Ende der zyklischen Versendung erkannt wird, muss die Versendung der Stoppnachricht (Signal Anforderung_Steuerung_Elektrolüfter = 0) insgesamt 3-mal mit einem Wiederholzyklus von t=160 ms erfolgen (Details in der Spezifikation: Erweiterung der ereignisgesteuerten Auslösebedingungen).
Zusätzlich erfolgt eine zyklische Versendung der Nachricht, wenn die Signale Temperatur_Komponente_Wärmemanagement und ID_Temperatur_Komponente_Wärmemanagement befüllt sind.</L-2>
                            </DESC>
                            <TIME-PERIOD>
                              <TOLERANCE>
                                <ABSOLUTE-TOLERANCE>
                                  <ABSOLUTE>0.1</ABSOLUTE>
                                </ABSOLUTE-TOLERANCE>
                              </TOLERANCE>
                              <VALUE>1</VALUE>
                            </TIME-PERIOD>
                          </CYCLIC-TIMING>
                        </TRANSMISSION-MODE-TRUE-TIMING>
                      </TRANSMISSION-MODE-DECLARATION>
                    </I-PDU-TIMING>
                  </I-PDU-TIMING-SPECIFICATIONS>
