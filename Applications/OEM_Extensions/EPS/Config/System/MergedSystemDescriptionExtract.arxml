                                  <ABSOLUTE>0.5</ABSOLUTE>
                                </ABSOLUTE-TOLERANCE>
                              </TOLERANCE>
                              <VALUE>5</VALUE>
                            </TIME-PERIOD>
                          </CYCLIC-TIMING>
                          <EVENT-CONTROLLED-TIMING>
                            <DESC>
                              <L-2 L="DE">Die Nachricht wird bei einer beliebigen Änderung des Signals "Steuerung Fehlerspeicher Bordnetzspannung" ereignisgesteuert versendet.</L-2>
                            </DESC>
                            <NUMBER-OF-REPETITIONS>0</NUMBER-OF-REPETITIONS>
                          </EVENT-CONTROLLED-TIMING>
                        </TRANSMISSION-MODE-TRUE-TIMING>
                      </TRANSMISSION-MODE-DECLARATION>
