                            <SYMBOL>QU_ACLNY_COG_SignalwertIstGueltig</SYMBOL>
                            <DESC>
                              <L-2 L="DE">Nutzsignal verfügbar, bereitgestellt aus einem Sensor (Nur bei einfacher Sensorik) elektrische und Modellüberwachung i.O.</L-2>
                              <L-2 L="FOR-ALL">BNE original name: Signalwert ist gültig</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">2</LOWER-LIMIT>
