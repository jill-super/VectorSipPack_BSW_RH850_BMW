                <I-SIGNAL-I-PDU UUID="_2d91f731ef854e209f0a9d17b0596648">
                  <SHORT-NAME>RQ_STG_EFAN</SHORT-NAME>
                  <LONG-NAME>
                    <L-4 L="DE">Anforderung Wärmemanagement</L-4>
                    <L-4 L="EN">Request Stage Electric-Fan</L-4>
                  </LONG-NAME>
