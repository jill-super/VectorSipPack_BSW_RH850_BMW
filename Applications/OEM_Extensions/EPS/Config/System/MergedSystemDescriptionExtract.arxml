                      <TRANSMISSION-MODE-DECLARATION>
                        <TRANSMISSION-MODE-TRUE-TIMING>
                          <CYCLIC-TIMING>
                            <TIME-PERIOD>
                              <TOLERANCE>
                                <ABSOLUTE-TOLERANCE>
                                  <ABSOLUTE>0.1</ABSOLUTE>
                                </ABSOLUTE-TOLERANCE>
                              </TOLERANCE>
                              <VALUE>1</VALUE>
                            </TIME-PERIOD>
                          </CYCLIC-TIMING>
                          <EVENT-CONTROLLED-TIMING>
                            <DESC>
                              <L-2 L="DE">$(ET;2;10) Wird bei Änderung des Signals ST_OFFS_QUAD_EPS 2-malig mit einem Wiederholzyklus von t = 10 ms versendet.</L-2>
                            </DESC>
                            <NUMBER-OF-REPETITIONS>1</NUMBER-OF-REPETITIONS>
                            <REPETITION-PERIOD>
                              <VALUE>0.01</VALUE>
                            </REPETITION-PERIOD>
                          </EVENT-CONTROLLED-TIMING>
                        </TRANSMISSION-MODE-TRUE-TIMING>
                      </TRANSMISSION-MODE-DECLARATION>
