                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/SystemDescription/DataConstrs/AVL_PINA_EPS</DATA-CONSTR-REF>
                        <INVALID-VALUE>
                          <NUMERICAL-VALUE-SPECIFICATION>
                            <VALUE>65535</VALUE>
                          </NUMERICAL-VALUE-SPECIFICATION>
