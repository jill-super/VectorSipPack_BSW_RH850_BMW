                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@5fab1ec6 (name: QU_FN_EST) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
