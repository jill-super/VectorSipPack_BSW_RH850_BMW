                  <SHORT-NAME>QU_AVL_PINA_EPS</SHORT-NAME>
                  <LONG-NAME>
                    <L-4 L="DE">Qualifier_Ist_Ritzelwinkel_EPS</L-4>
                    <L-4 L="EN">Qualifier_actual-value_pinion-angle_EPS</L-4>
                  </LONG-NAME>
                  <CATEGORY>TEXTTABLE</CATEGORY>
                  <ADMIN-DATA>
                    <DOC-REVISIONS>
                      <DOC-REVISION>
                        <REVISION-LABEL>5.0.0</REVISION-LABEL>
                        <STATE>closed</STATE>
                        <DATE>2017-01-09T00:00:00Z</DATE>
                      </DOC-REVISION>
