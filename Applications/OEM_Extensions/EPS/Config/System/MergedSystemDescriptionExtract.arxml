                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/AUTOSAR_Platform/BaseTypes/uint16</BASE-TYPE-REF>
                        <COMPU-METHOD-REF DEST="COMPU-METHOD">/BMW/SystemDescription/CompuMethods/VYAW_VEH_ERR_AMP</COMPU-METHOD-REF>
                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/BMW/SystemDescription/DataConstrs/VYAW_VEH_ERR_AMP</DATA-CONSTR-REF>
                        <INVALID-VALUE>
                          <NUMERICAL-VALUE-SPECIFICATION>
                            <VALUE>4095</VALUE>
                          </NUMERICAL-VALUE-SPECIFICATION>
                        </INVALID-VALUE>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
