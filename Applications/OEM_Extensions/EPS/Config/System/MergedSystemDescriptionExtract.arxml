                            <SD GID="SOURCE_TO_STRING.0">com.bmw.symphony.sym10.fibex.impl.SignalImpl@76312df9 (name: QU_VYAW_VEH) (hasInvalid: true, priority: null)</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
